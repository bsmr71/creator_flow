APP_NAME=CreatorFlow
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://app.creatorflow.id

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=creatorflow
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@creatorflow.id"
MAIL_FROM_NAME="${APP_NAME}"

# Meta Graph API (Official Instagram Professional & Facebook Pages)
META_APP_ID=
META_APP_SECRET=
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
META_REDIRECT_URI="${APP_URL}/integrations/meta/callback"
META_WEBHOOK_VERIFY_TOKEN=creatorflow_meta_verify_secret
META_GRAPH_VERSION=v21.0

# WhatsApp Business Cloud API (Official Meta Platform)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_BUSINESS_ACCOUNT_ID=

# DOKU Payment Gateway (QRIS, BCA, Mandiri, BRI, Kartu Kredit)
DOKU_CLIENT_ID=
DOKU_SECRET_KEY=
DOKU_ENV=production
DOKU_NOTIFICATION_URL="${APP_URL}/api/webhooks/doku"

VITE_APP_NAME="${APP_NAME}"
